# VerifyAI Environment Configuration (SIH26261)
# Safe Template — DO NOT COMMIT REAL PRODUCTION SECRETS

# Server Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_PORT=5173

# Database URL (Default: local SQLite database, or PostgreSQL in production)
DATABASE_URL=sqlite:///./verifyai.db
# DATABASE_URL=postgresql://verifyai_user:your_secure_password_here@localhost:5432/verifyai_db

# Security & JWT Configuration
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Verification & Benchmark Engine
VERIFYAI_MIN_SUPPORT_SIMILARITY=0.35
VERIFYAI_SCAN_SECURITY=true
MAX_REQUEST_BODY_MB=25

# Demo Mode & Environment Flags
ENVIRONMENT=development
MOCK_VERIFICATION_ENABLED=true
